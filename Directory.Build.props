<Project>

  <!-- Per-mod identity. Everything else lives in Directory.Build.targets /
       Directory.Packages.props, which are identical across all inten-gg mod repos.

       No repo-wide AssemblyName/RootNamespace here: this repo builds two assemblies
       (Robots and FaceLaserTesting), and the Defs reference both by namespace. -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ModDevName>Fallout Races: The Robots Pack (Continued) (DEV)</ModDevName>
    <ModDevPackageId>gg.inten.rimworld.fallout.robots.dev</ModDevPackageId>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldPath)'==''">
    <RimWorldPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldPath Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.steam/steam/steamapps/common/RimWorld</RimWorldPath>
  </PropertyGroup>

  <PropertyGroup>
    <UseLocalRimWorldRefs Condition="Exists('$(RimWorldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll')">true</UseLocalRimWorldRefs>
  </PropertyGroup>

</Project>
